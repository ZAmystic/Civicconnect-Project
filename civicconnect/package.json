
{
  "name": "civicconnect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/main.ts",
    "dev:client": "vite --clearScreen false",
    "test:db": "tsx src/test-db.ts",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@types/node": "^26.6.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "ts-zxcvbn": "^7.0.2"
  }
}
