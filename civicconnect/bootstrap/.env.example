# CivicConnect API - environment configuration blueprint (Layer 2, RubberDucks_FINAL_Assignment3 s3.1.2)
# Copy to .env for local development and fill in real values.
# .env itself must NEVER be committed - see .gitignore and A3 Q2 Chain 3 (Secrets & Configuration).
# Config is read from environment variables only, never hard-coded (Wiggins, 2017; NIST, 2020).

NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL, ADR-02) ---
DATABASE_URL=postgres://civicconnect_user:changeme@localhost:5432/civicconnect_dev
DATABASE_POOL_MAX=10

# --- Auth / RBAC (A3 Q2 Chain 1-2) ---
SESSION_SECRET=replace-with-a-long-random-value-never-commit-the-real-one
SESSION_COOKIE_SECURE=true

# --- Notification provider adapter (Observer -> external REST, ADR-03/ADR-04) ---
NOTIFICATION_PROVIDER_API_KEY=replace-with-real-key-in-local-env-or-vault
NOTIFICATION_PROVIDER_BASE_URL=https://api.example-notification-provider.com

# --- Contractor adapter (Adapter pattern, ADR-04, Member 3) ---
CONTRACTOR_API_BASE_URL=https://api.example-contractor-system.com
CONTRACTOR_API_KEY=replace-with-real-key-in-local-env-or-vault
